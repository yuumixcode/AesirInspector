      SerializationNodes:
      - Name: info
        Entry: 1
        Data: RequiredIn is specific to prefabs. It only shows validation errors
          when the inspected object is a certain kind of prefab (for example a regular
          prefab asset or a prefab instance in a scene).
      - Name: instanceInScene
        Entry: 1
        Data: Instances of prefabs in scenes
      - Name: instanceInPrefab
        Entry: 1
        Data: Instances of prefabs nested inside other prefabs
      - Name: regular
        Entry: 1
        Data: Regular prefab assets
      - Name: variant
        Entry: 1
        Data: Prefab variant assets
      - Name: nonPrefabInstance
        Entry: 1
        Data: Non-prefab component or gameobject instances in scenes
      - Name: prefabInstance
        Entry: 1
        Data: Instances of regular prefabs, and prefab variants in scenes or nested
          in other prefabs
      - Name: prefabAsset
        Entry: 1
        Data: Prefab assets and prefab variant assets
      - Name: prefabInstanceAndNonPrefabInstance
        Entry: 1
        Data: Prefab instances, as well as non-prefab instances
